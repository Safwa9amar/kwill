+// kwill patch: no top-level await (Metro wraps modules in a non-async function,
+// so `await` here is a ReferenceError in a WebView). The shaper is initialised
+// lazily through load(); the host awaits it before creating an editor, and can
+// pass Emscripten's `locateFile` to say where harfbuzz.wasm is served from.
+let ready;
+function load(moduleArg = {}) {
+	return (ready ??= createHarfBuzz(moduleArg).then(init));
+}
