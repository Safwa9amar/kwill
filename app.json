{
  "expo": {
    "name": "Kwill",
    "slug": "modakerati",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kwill",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/8994cc05-5a16-4ea4-a498-89c27eea3b55",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "ios": {
      "icon": "./assets/AppIcon.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.kwill.app",
      "buildNumber": "2",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Kwill uses speech recognition to turn your voice into text in your thesis.",
        "NSMicrophoneUsageDescription": "Kwill uses your microphone to dictate text into your thesis.",
        "NSCameraUsageDescription": "Kwill uses the camera to let you take a photo and insert it into your thesis document — for example, photographing a printed chart, a lab result, or handwritten notes to add as a figure in a chapter.",
        "NSPhotoLibraryUsageDescription": "Kwill uses your photo library to let you choose images to insert into your thesis document or attach to the AI assistant — for example, selecting a graph or diagram from your photos to add as a figure in a chapter."
      },
      "appleTeamId": "VM5A7U2YT2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.kwill.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 6,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_APP_BADGE",
        "com.sec.android.provider.badge.permission.READ",
        "com.sec.android.provider.badge.permission.WRITE",
        "com.htc.launcher.permission.READ_SETTINGS",
        "com.htc.launcher.permission.UPDATE_SHORTCUT",
        "com.sonyericsson.home.permission.BROADCAST_BADGE",
        "com.sonymobile.home.permission.PROVIDER_INSERT_BADGE",
        "com.anddoes.launcher.permission.UPDATE_COUNT",
        "com.majeur.launcher.permission.UPDATE_BADGE",
        "com.huawei.android.launcher.permission.CHANGE_BADGE",
        "com.huawei.android.launcher.permission.READ_SETTINGS",
        "com.huawei.android.launcher.permission.WRITE_SETTINGS",
        "com.oppo.launcher.permission.READ_SETTINGS",
        "com.oppo.launcher.permission.WRITE_SETTINGS",
        "me.everything.badger.permission.BADGE_COUNT_READ",
        "me.everything.badger.permission.BADGE_COUNT_WRITE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#F59433"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#121220",
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 170,
            "resizeMode": "contain",
            "backgroundColor": "#121220"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kwill uses the camera to let you take a photo and insert it into your thesis document — for example, photographing a printed chart, a lab result, or handwritten notes to add as a figure in a chapter.",
          "photosPermission": "Kwill uses your photo library to let you choose images to insert into your thesis document or attach to the AI assistant — for example, selecting a graph or diagram from your photos to add as a figure in a chapter."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kwill uses your microphone to dictate text into your thesis.",
          "speechRecognitionPermission": "Kwill uses speech recognition to turn your voice into text in your thesis."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "./plugins/withReleaseSigning",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8994cc05-5a16-4ea4-a498-89c27eea3b55"
      }
    },
    "owner": "astro0666"
  }
}
